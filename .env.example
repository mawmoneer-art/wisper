# Copy this file to .env and fill it in. .env is ignored by git.

# Dashboard > Org settings > API keys. Keep it private.
VAPI_API_KEY=

# How the assistant refers to you on calls.
MY_NAME=

# Step 3: the Vapi ID of your imported Twilio number (Dashboard > Phone Numbers > click the number > copy the ID).
PHONE_NUMBER_ID=

# Step 5: the Apps Script web app URL, including ?key=YOUR_SECRET on the end.
BOOK_MEETING_URL=
